+@app.route("/forward-test/preflight.json")
+def forward_test_preflight():
+    """Looks (changes nothing) at everything a forward test needs and says what is ready, what T58 will do by itself
+    on Start, and what needs the user. Drives the 'Ready check' card on the Forward Test page."""
+    from app.forward_test import mt5_diagnostics as ft_diag
+    from app.live_deploy.live_settings import load_accounts
+    accounts = [a for a in load_accounts() if a.platform == "MT4/MT5"]
+    account = next((a for a in accounts if a.id == request.args.get("account_id")), accounts[0] if accounts else None)
+    out = ft_diag.preflight(account.terminal_path if account else "", deep=request.args.get("deep") == "1")
+    if account is None or not account.is_usable:
+        p = ft_diag.account_missing()
+        out["checks"].insert(0, {"id": "account", "label": "MT5 account saved", "status": "action",
+                                 "detail": p.summary, "fix": p.steps, "commands": []})
+        out["ready"] = False
+        out["headline"] = "Save your MT5 account first, then you can start."
+    else:
+        out["checks"].insert(0, {"id": "account", "label": "MT5 account saved", "status": "ok",
+                                 "detail": f"{account.nickname or account.login} ({account.server})", "fix": [], "commands": []})
+    return jsonify(out)
+

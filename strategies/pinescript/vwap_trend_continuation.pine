// VWAP Trend Continuation (ema 50/100, rsi7)
//
// IMPORTANT -- written for the T58 Quant Algo Backtester's PineScript
// importer (app/strategy/pinescript.py), which parses a narrow SUBSET of
// Pine: only ta.sma/ema/wma/rsi, ta.crossover/crossunder, plain
// comparisons, and strategy.entry()/strategy.close(). It does NOT support
// ta.atr, ta.vwap, or custom functions -- the previous version used both
// and the parser had nothing it could turn into an entry/exit condition,
// hence zero trades.
//
// VWAP SUBSTITUTION: this engine's own manual/JSON VWAP indicator ignores
// the "period" field entirely and uses a session-anchored cumulative VWAP
// -- something this parser's supported-function list simply cannot
// express (no volume-weighted cumulative sum available). ta.sma(hlc3, N)
// is used below as the closest available stand-in (a short-lookback
// average of the typical price). If you paste this into real TradingView
// and want a true VWAP, swap vwapLong/vwapShort for ta.vwap(hlc3).
//
// ATR PERIOD LIMIT: this parser only supports ONE T58_ATR_PERIOD shared by
// both the stop and target multipliers (the JSON spec's stop_atr_period=16
// and target_atr_period=11 can't both be expressed here) -- 16 is used
// below for both.
//
// MAX-BARS-IN-TRADE: this parser has no max_bars_in_trade equivalent
// (only the "manual" JSON adapter supports it) -- not represented here.

//@version=5
strategy("VWAP Trend Continuation (ema 50/100, rsi7)", overlay=true, initial_capital=100000)

emaLongSlowLen  = input.int(294, "Long EMA Slow")
emaLongFastLen  = input.int(58,  "Long EMA Fast")
emaShortFastLen = input.int(35,  "Short EMA Fast")
emaShortSlowLen = input.int(159, "Short EMA Slow")

rsiLongLen  = input.int(18, "RSI Long Period")
rsiShortLen = input.int(42, "RSI Short Period")
rsiExitLen  = input.int(5,  "RSI Exit Period")

vwapLongLen  = input.int(4, "VWAP-proxy SMA Period (Long)")
vwapShortLen = input.int(3, "VWAP-proxy SMA Period (Short)")

emaLongSlow  = ta.ema(close, emaLongSlowLen)
emaLongFast  = ta.ema(close, emaLongFastLen)
emaShortFast = ta.ema(close, emaShortFastLen)
emaShortSlow = ta.ema(close, emaShortSlowLen)

rsiLong  = ta.rsi(close, rsiLongLen)
rsiShort = ta.rsi(close, rsiShortLen)
rsiExit  = ta.rsi(close, rsiExitLen)

vwapLong  = ta.sma(hlc3, vwapLongLen)
vwapShort = ta.sma(hlc3, vwapShortLen)

longCondition = emaLongSlow > emaLongFast and close > vwapLong and rsiLong < 57.6102629644959
shortCondition = emaShortFast < emaShortSlow and close < vwapShort and rsiShort > 66.008585331847

exitLongCondition = rsiExit > 66.68737207001313
exitShortCondition = rsiExit < 64.42442560822603

if longCondition
    strategy.entry("Long", strategy.long)

if shortCondition
    strategy.entry("Short", strategy.short)

strategy.close("Long", when=exitLongCondition)
strategy.close("Short", when=exitShortCondition)

// T58_SL_ATR_MULT=4.806786275425379
// T58_TP_ATR_MULT=5.054720923946611
// T58_ATR_PERIOD=16
